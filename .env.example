# Base URL for your Ada AI Agent API (e.g., https://my-agent.ada.support/api)
ADA_BASE_URL="https://<handle>[.<region>].ada.support/api"
# Platform API Key from Dashboard > Config > Platform > APIs
ADA_API_KEY=
# Webhook Signing Secret from Dashboard > Config > Platform > Webhooks > Your Endpoint > Signing Secret
WEBHOOK_SECRET=
